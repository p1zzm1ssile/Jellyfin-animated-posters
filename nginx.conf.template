# This file is a template: when the container starts, nginx's entrypoint fills in
# ${JELLYFIN_URL} and ${NGINX_LOCAL_RESOLVERS} and writes it to /etc/nginx/conf.d/default.conf.

# JELLYFIN_URL without any trailing slash, e.g. http://192.168.1.10:8096
map "${JELLYFIN_URL}" $jellyfin_base {
    "~^(?<base>.*?)/*$" $base;
}
# The rest of the address after /jellyfin, still encoded and with its query string
map $request_uri $jellyfin_path {
    "~^/jellyfin(?<rest>/.*)$" $rest;
    default /;
}

server {
    listen 8097;
    listen [::]:8097;
    root /usr/share/nginx/html;

    location / {
        try_files $uri $uri/ =404;
    }

    # Folders mapped into /media are listed as JSON for the page's "Server media" browser.
    # The files are only read, and only by your browser on your own network.
    location /media/ {
        alias /media/;
        autoindex on;
        autoindex_format json;
    }

    # "Send to Jellyfin": the page talks to Jellyfin through here, so the browser
    # sees one address and Jellyfin needs no CORS settings.
    location /jellyfin/ {
        default_type application/json;
        if ($jellyfin_base = "") {
            return 503 '{"notConfigured":true}';
        }
        resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;
        client_max_body_size 64m;
        proxy_read_timeout 120s;
        proxy_pass $jellyfin_base$jellyfin_path;
    }
}
